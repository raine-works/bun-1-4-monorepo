{
	"name": "bun-1-4-monorepo",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"catalog": {
		"@biomejs/biome": "2.5.10",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"@types/bun": "1.4.0",
		"typescript": "7.0.2",
		"tailwindcss": "4.3.3",
		"bun-plugin-tailwind": "0.1.2",
		"@tanstack/react-router": "1.170.32",
		"@hono/zod-validator": "0.9.0",
		"hono": "4.13.5",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@types/bun": "catalog:",
		"bun-plugin-tailwind": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"zod": "catalog:"
	},
	"scripts": {
		"build": "bun run --concurrent --filter '*' build",
		"dev": "bun run --parallel --filter '*' dev",
		"dev:init": "docker compose -f docker/compose.yaml up -d",
		"docker:build": "bun run --parallel --filter '*' docker:build",
		"docker:run": "bun run --filter @app/backend docker:run",
		"format": "biome format --write .",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"migrate": "bun run --filter @app/data migrate",
		"migrate:create": "bun run --filter @app/data migrate:create",
		"migrate:down": "bun run --filter @app/data migrate:down",
		"migrate:status": "bun run --filter @app/data migrate:status",
		"start": "bun run --filter @app/backend start",
		"test": "bun test --parallel",
		"typecheck": "tsc --noEmit"
	}
}
