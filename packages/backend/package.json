{
	"name": "@app/backend",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./client": "./src/rpc.ts",
		"./rpc": "./src/rpc.ts",
		"./*": "./src/*"
	},
	"scripts": {
		"build": "bun scripts/build.ts",
		"dev": "bun --watch src/index.ts",
		"docker:build": "docker build -f Dockerfile -t app-backend ../..",
		"docker:run": "docker run --rm --network bun-1-4-monorepo_default -e DATABASE_URL=postgres://dev_user:dev_password@postgres:5432/dev_db -p 3000:3000 app-backend",
		"start": "dist/server",
		"test": "bun test"
	},
	"dependencies": {
		"@app/data": "workspace:*",
		"@app/docs": "workspace:*",
		"@app/hub": "workspace:*",
		"@app/store": "workspace:*",
		"@hono/zod-validator": "catalog:",
		"hono": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:"
	}
}
