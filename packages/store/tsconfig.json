{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"types": ["bun", "react", "react-dom"],
		"paths": {
			"@/*": ["./src/*"],
			"@store": ["./src/index.tsx"],
			"@store/*": ["./src/*"],
			"@app/store": ["./src/index.tsx"],
			"@app/store/*": ["./src/*"],
			"@data": ["../data/src/index.ts"],
			"@data/*": ["../data/src/*"],
			"@app/data": ["../data/src/index.ts"],
			"@app/data/*": ["../data/src/*"],
			"@backend": ["../backend/src/index.ts"],
			"@backend/*": ["../backend/src/*"],
			"@app/backend": ["../backend/src/index.ts"],
			"@app/backend/*": ["../backend/src/*"]
		}
	},
	"include": ["src/**/*", "scripts/**/*"]
}
