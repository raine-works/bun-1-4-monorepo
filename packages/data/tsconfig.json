{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"types": ["bun"],
		"paths": {
			"@/*": ["./src/*"],
			"@data": ["./src/index.ts"],
			"@data/*": ["./src/*"],
			"@app/data": ["./src/index.ts"],
			"@app/data/*": ["./src/*"],
			"@contracts": ["./src/contracts/index.ts"],
			"@contracts/*": ["./src/contracts/*"],
			"@queries": ["./src/queries/index.ts"],
			"@queries/*": ["./src/queries/*"],
			"@client": ["./src/client.ts"],
			"@env": ["./src/env.ts"],
			"@migrator": ["./src/migrator.ts"],
			"@tools": ["../tools/src/index.ts"],
			"@tools/*": ["../tools/src/*"],
			"@app/tools": ["../tools/src/index.ts"],
			"@app/tools/*": ["../tools/src/*"]
		}
	},
	"include": ["src/**/*", "scripts/**/*"]
}
