{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["bun"],
    "paths": {
      "@/*": ["./src/*"],
      "@data": ["./src/index.ts"],
      "@data/*": ["./src/*"],
      "@app/data": ["./src/index.ts"],
      "@app/data/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "scripts/**/*", "tests/**/*"]
}
