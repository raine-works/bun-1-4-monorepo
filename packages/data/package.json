{
	"name": "@app/data",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./client": "./src/client.ts",
		"./env": "./src/env.ts",
		"./contracts": "./src/contracts/index.ts",
		"./contracts/*": "./src/contracts/*.ts",
		"./migrator": "./src/migrator.ts",
		"./queries": "./src/queries/index.ts",
		"./queries/*": "./src/queries/*.ts",
		"./*": "./src/*"
	},
	"scripts": {
		"migrate": "bun scripts/migrate.ts up",
		"migrate:down": "bun scripts/migrate.ts down",
		"migrate:status": "bun scripts/migrate.ts status",
		"migrate:create": "bun scripts/migrate.ts create",
		"migrate:reset": "bun scripts/migrate.ts reset",
		"test": "bun test",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:"
	}
}
