{
	"compilerOptions": {
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"module": "preserve",
		"target": "ESNext",
		"moduleResolution": "bundler",
		"moduleDetection": "force",
		"jsx": "react-jsx",
		"allowJs": true,
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,
		"types": ["bun"],
		"paths": {
			"@/*": [
				"./packages/backend/src/*",
				"./packages/data/src/*",
				"./packages/docs/src/*",
				"./packages/hub/src/*",
				"./packages/store/src/*",
				"./packages/tools/src/*",
				"./packages/ui/src/*"
			],
			"@backend": ["./packages/backend/src/index.ts"],
			"@backend/*": ["./packages/backend/src/*"],
			"@data": ["./packages/data/src/index.ts"],
			"@data/*": ["./packages/data/src/*"],
			"@docs": ["./packages/docs/src/index.tsx"],
			"@docs/*": ["./packages/docs/src/*"],
			"@hub": ["./packages/hub/src/index.tsx"],
			"@hub/*": ["./packages/hub/src/*"],
			"@store": ["./packages/store/src/index.tsx"],
			"@store/*": ["./packages/store/src/*"],
			"@tools": ["./packages/tools/src/index.ts"],
			"@tools/*": ["./packages/tools/src/*"],
			"@ui": ["./packages/ui/src/index.ts"],
			"@ui/*": ["./packages/ui/src/*"],
			"@app/backend": ["./packages/backend/src/index.ts"],
			"@app/backend/*": ["./packages/backend/src/*"],
			"@app/data": ["./packages/data/src/index.ts"],
			"@app/data/*": ["./packages/data/src/*"],
			"@app/docs": ["./packages/docs/src/index.tsx"],
			"@app/docs/*": ["./packages/docs/src/*"],
			"@app/hub": ["./packages/hub/src/index.tsx"],
			"@app/hub/*": ["./packages/hub/src/*"],
			"@app/store": ["./packages/store/src/index.tsx"],
			"@app/store/*": ["./packages/store/src/*"],
			"@app/tools": ["./packages/tools/src/index.ts"],
			"@app/tools/*": ["./packages/tools/src/*"],
			"@app/ui": ["./packages/ui/src/index.ts"],
			"@app/ui/*": ["./packages/ui/src/*"]
		}
	}
}
